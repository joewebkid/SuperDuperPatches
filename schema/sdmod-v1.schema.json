{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:superduper:sdmod:schema:v1",
  "title": "Super Duper resource mod manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "id",
    "name",
    "version",
    "kind",
    "engine",
    "target",
    "budgets",
    "license",
    "resources"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$",
      "maxLength": 96
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
      "maxLength": 64
    },
    "kind": { "const": "resource-mod" },
    "priority": { "type": "integer", "minimum": 0, "maximum": 1000, "default": 100 },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceOverlayApi", "minimumVersion"],
      "properties": {
        "resourceOverlayApi": { "const": 1 },
        "minimumVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "maximumVersion": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "target": { "$ref": "#/$defs/target" },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payloadBytes", "maximumResidentBytes"],
      "properties": {
        "payloadBytes": { "type": "integer", "minimum": 0, "maximum": 4294967296 },
        "maximumResidentBytes": { "type": "integer", "minimum": 0, "maximum": 4294967296 }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["redistributable", "name", "attribution"],
      "properties": {
        "redistributable": { "const": true },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "spdx": { "type": "string", "minLength": 1, "maxLength": 64 },
        "attribution": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "sourceUrl": { "type": "string", "format": "uri", "maxLength": 2048 }
      }
    },
    "dependsOn": {
      "type": "array",
      "items": { "$ref": "#/$defs/packageId" },
      "uniqueItems": true,
      "default": []
    },
    "conflictsWith": {
      "type": "array",
      "items": { "$ref": "#/$defs/packageId" },
      "uniqueItems": true,
      "default": []
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/resource" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$",
      "maxLength": 96
    },
    "safePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$",
      "maxLength": 1024
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundleId", "bundleVersions", "executableSha256"],
      "properties": {
        "bundleId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "bundleVersions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 },
          "uniqueItems": true
        },
        "executableSha256": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sha256" },
          "uniqueItems": true
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guestPath",
        "sourceSha256",
        "payloadPath",
        "replacementSha256",
        "payloadBytes",
        "maximumResidentBytes"
      ],
      "properties": {
        "guestPath": { "$ref": "#/$defs/safePath" },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "payloadPath": { "$ref": "#/$defs/safePath" },
        "replacementSha256": { "$ref": "#/$defs/sha256" },
        "payloadBytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "maximumResidentBytes": { "type": "integer", "minimum": 0, "maximum": 2147483648 },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}

