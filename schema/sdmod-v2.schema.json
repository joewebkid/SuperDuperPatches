{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:superduper:sdmod:schema:v2",
  "title": "Super Duper ordered overlay manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "id",
    "name",
    "version",
    "kind",
    "engine",
    "target",
    "budgets",
    "license",
    "overlays"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "const": 2 },
    "id": { "$ref": "#/$defs/packageId" },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
      "maxLength": 64
    },
    "kind": { "const": "overlay-mod" },
    "priority": { "type": "integer", "minimum": 0, "maximum": 1000, "default": 100 },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overlayApi", "minimumVersion"],
      "properties": {
        "overlayApi": { "const": 2 },
        "minimumVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "maximumVersion": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundleId", "bundleVersions", "ipaSha256", "executableSha256"],
      "properties": {
        "bundleId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "bundleVersions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 },
          "uniqueItems": true
        },
        "ipaSha256": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sha256" },
          "uniqueItems": true
        },
        "executableSha256": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sha256" },
          "uniqueItems": true
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payloadBytes", "maximumOutputBytes", "maximumResidentBytes"],
      "properties": {
        "payloadBytes": { "type": "integer", "minimum": 0, "maximum": 4294967296 },
        "maximumOutputBytes": { "type": "integer", "minimum": 0, "maximum": 4294967296 },
        "maximumResidentBytes": { "type": "integer", "minimum": 0, "maximum": 4294967296 }
      }
    },
    "license": { "$ref": "#/$defs/license" },
    "dependsOn": {
      "type": "array",
      "items": { "$ref": "#/$defs/packageId" },
      "uniqueItems": true,
      "default": []
    },
    "conflictsWith": {
      "type": "array",
      "items": { "$ref": "#/$defs/packageId" },
      "uniqueItems": true,
      "default": []
    },
    "overlays": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/overlay" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$",
      "maxLength": 96
    },
    "safePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$",
      "maxLength": 1024
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["redistributable", "name", "attribution"],
      "properties": {
        "redistributable": { "const": true },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "spdx": { "type": "string", "minLength": 1, "maxLength": 64 },
        "attribution": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "sourceUrl": { "type": "string", "format": "uri", "maxLength": 2048 }
      }
    },
    "overlayCommon": {
      "type": "object",
      "required": [
        "type",
        "targetClass",
        "guestPath",
        "sourceSha256",
        "resultSha256",
        "payloadPath",
        "payloadSha256",
        "payloadBytes",
        "resultBytes",
        "maximumResidentBytes"
      ],
      "properties": {
        "targetClass": { "enum": ["resource", "macho"] },
        "guestPath": { "$ref": "#/$defs/safePath" },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "resultSha256": { "$ref": "#/$defs/sha256" },
        "payloadPath": { "$ref": "#/$defs/safePath" },
        "payloadSha256": { "$ref": "#/$defs/sha256" },
        "payloadBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "resultBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "maximumResidentBytes": { "type": "integer", "minimum": 0, "maximum": 2147483648 },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "replaceOverlay": {
      "allOf": [
        { "$ref": "#/$defs/overlayCommon" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "const": "replace" },
            "targetClass": { "const": "resource" },
            "guestPath": true,
            "sourceSha256": true,
            "resultSha256": true,
            "payloadPath": true,
            "payloadSha256": true,
            "payloadBytes": true,
            "resultBytes": true,
            "maximumResidentBytes": true,
            "mediaType": true
          }
        }
      ]
    },
    "vcdiffOverlay": {
      "allOf": [
        { "$ref": "#/$defs/overlayCommon" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["vcdiffProfile"],
          "properties": {
            "type": { "const": "vcdiff" },
            "targetClass": true,
            "guestPath": true,
            "sourceSha256": true,
            "resultSha256": true,
            "payloadPath": true,
            "payloadSha256": true,
            "payloadBytes": { "type": "integer", "minimum": 1, "maximum": 268435456 },
            "resultBytes": { "type": "integer", "minimum": 1, "maximum": 268435456 },
            "maximumResidentBytes": { "type": "integer", "minimum": 1, "maximum": 536870912 },
            "mediaType": true,
            "vcdiffProfile": { "const": "rfc3284-xdelta3-no-extensions" }
          }
        }
      ]
    },
    "overlay": {
      "oneOf": [
        { "$ref": "#/$defs/replaceOverlay" },
        { "$ref": "#/$defs/vcdiffOverlay" }
      ]
    }
  }
}
